NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only set this once you've configured the wildcard domain in Vercel (see
# the deploy steps) — until then, leave it blank and the app stays fully
# open with no subdomain rewriting or auth gate, exactly like it is now.
NEXT_PUBLIC_ROOT_DOMAIN=

# Optional, only needed once you wire the scraper/outreach pieces back in
APIFY_TOKEN=
VERCEL_API_TOKEN=
